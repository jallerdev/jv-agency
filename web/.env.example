# URL del endpoint de leads entrantes de HalcónOS.
# Local:      http://localhost:3000/api/inbound/lead
# Producción: https://TU-DOMINIO-HALCON/api/inbound/lead
HALCON_INBOUND_URL=""

# API key generada en HalcónOS → Ajustes (es única por organización).
# Solo vive en el servidor; nunca se expone al navegador.
HALCON_INBOUND_API_KEY=""

# --- Google Calendar / Meet ---
# OAuth client (tipo "Web application") creado en Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Refresh token de la cuenta del estudio. Genéralo con: node scripts/google-auth.mjs
GOOGLE_REFRESH_TOKEN=""
# Calendario donde se crean los eventos (por defecto el principal de la cuenta).
GOOGLE_CALENDAR_ID="primary"
# Zona horaria del estudio para los horarios ofrecidos.
STUDIO_TIMEZONE="America/Bogota"
